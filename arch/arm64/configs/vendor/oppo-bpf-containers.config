# ==============================================================================
# BPF + 容器（droidspaces）支持 —— 4.19 配置片段
# ------------------------------------------------------------------------------
# 用法：和其他 fragment 一起交给同一次 make 调用：
#   make O=out ARCH=arm64 vendor/msm8953-perf_defconfig vendor/mi8953.config \
#        vendor/oppo-16017.config vendor/oppo-bpf-containers.config
#
# 注意：本文件里不要出现任何形如 "# CONFIG_XXX is not set" 的**说明性**注释。
#   merge_config.sh 的解析正则是 ^\(# \)\{0,1\}\(CONFIG_[A-Za-z0-9_]*\)[= ]
#   命中后会执行 sed -i "/$CFG[ =]/d" 把同名符号整行删掉，
#   于是"注释掉的说明"会把真正想设的符号一起干掉。
# ==============================================================================

# ---- BPF ----------------------------------------------------------------------
# 基线 msm8953-perf_defconfig 已经给了 BPF_SYSCALL / BPF_JIT /
# BPF_JIT_ALWAYS_ON / CGROUP_BPF，这里显式重申，保证任何合并顺序下都不丢。
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_EVENTS=y

# ---- 容器运行所需的名字空间 ---------------------------------------------------
# 基线里 PID_NS 被显式关掉了（# CONFIG_PID_NS is not set），其余几个也没开。
# droidspaces 这类容器方案需要完整的 PID/UTS/IPC/NET/USER 名字空间才能
# 建立隔离环境；缺 PID_NS 时容器连 fork 隔离都做不到。
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# ---- cgroup 控制器 ------------------------------------------------------------
# 容器需要按 cgroup 限制/统计资源：
#   CGROUP_DEVICE  —— 设备白名单（容器里 /dev 访问控制）
#   CGROUP_PIDS    —— 进程数上限
#   CGROUP_NET_PRIO—— 网络优先级
#   CGROUP_SCHED   —— CPU 带宽/权重
#   CGROUP_FREEZER / CGROUP_CPUACCT 基线已有，一并重申。
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
# 4.19 里没有名为 CGROUP_SCHED 的符号，CPU 带宽控制由下面两个提供：
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y

# ---- 其他容器常用项 -----------------------------------------------------------
CONFIG_POSIX_MQUEUE=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
