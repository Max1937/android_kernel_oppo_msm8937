# ==============================================================================
# OPPO R9s (16017 / 16027, MSM8953 / Snapdragon 625) — 4.19 配置片段
# ------------------------------------------------------------------------------
# 用法：make O=out ARCH=arm64 vendor/msm8953-perf_defconfig vendor/mi8953.config \
#            vendor/oppo-16017.config
#   （vendor/mi8953.config 是必需项：qpnp-fg.c 无保护地引用
#     CONFIG_MACH_XIAOMI_MSM8953；本文件不启用任何 Xiaomi 机型）
#
# 内容来源：4.9 分支 arch/arm64/configs/lineageos_R9s_defconfig 相对
#           msm8953-perf_defconfig 的差异，逐条筛掉 4.19 已不存在的符号。
# ==============================================================================

# ---- OPPO 机型选择 ----
CONFIG_MACH_OPPO_MSM8953=y
CONFIG_MACH_16017=y
CONFIG_MACH_16027=y
CONFIG_OPPO_DEVICE_INFO=y

# ---- 触摸屏（R9s 用 Synaptics S3508 / S3320，I2C）----
CONFIG_SYNAPTICS_OPPO=y

# ---- 电池计 / VOOC 快充 ----
CONFIG_BATTERY_GAUGE_OPPO=y
CONFIG_BATTERY_GAUGE_OPPO_BQ27541=y
CONFIG_CHARGER_OPPO_VOOC=y

# ---- 输入 / 振动 ----
CONFIG_INPUT_QTI_HAPTICS=y
CONFIG_LEDS_VIBRATOR_GPIO=y

# ---- 存储 ----
CONFIG_OVERLAY_FS_INDEX=y

# ---- 调试/日志（pstore 抓早期 log）----
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_LZ4_COMPRESS=y

# ---- 隐藏面：限制 dmesg ----
CONFIG_SECURITY_DMESG_RESTRICT=y

# ---- 文件系统 ----
CONFIG_NLS_UTF8=y

# ---- 明确关闭：4.19 基线里不存在或本移植暂不做的 ----
# 说明：这些符号若在 4.19 中不存在，写了也只会被 Kconfig 忽略；
#       保留注释是为了记录 4.9 → 4.19 的差异决策。
# CONFIG_BACKLIGHT_LM3697        → 4.19 无此驱动（需从 4.9 移植，暂缓）
# CONFIG_KTD2026_SLED            → 4.19 无此驱动（需从 4.9 移植，暂缓）
# CONFIG_INPUT_FPC1020           → 4.19 无此驱动（需从 4.9 移植，暂缓）
# CONFIG_SND_SOC_AK4376          → 4.19 无此驱动（需从 4.9 移植，暂缓）
# CONFIG_SND_SOC_TFA98XX         → 4.19 无此驱动（需从 4.9 移植，暂缓）
