# ==============================================================================
# OPPO A57 (16061, MSM8940 / PMI8950) —— 4.19 配置片段
# ------------------------------------------------------------------------------
# 用法（在 R9s 的 fragment 基础上替换机型相关项）：
#   make O=out ARCH=arm64 vendor/msm8953-perf_defconfig vendor/mi8953.config \
#        vendor/oppo-a57.config vendor/oppo-bpf-containers.config
#
# 说明：msm8953-perf_defconfig 同时开了 ARCH_MSM8953 与 ARCH_MSM8937，
# 两份板级 DTB（R9s 的 16017/16027 与 A57 的 16061）可以共存于同一个
# Image.gz-dtb，ABL 按 board-id 选择：
#     R9s/16017 -> <8 0 16017>
#     R9sk/16027 -> <8 0 16027>
#     A57/16061 -> <8 0 16061>
#
# ⚠ merge_config.sh 的解析正则是
#     ^\(# \)\{0,1\}\(CONFIG_[A-Za-z0-9_]*\)[= ]
#   命中后会 sed -i "/$CFG[ =]/d" 删掉同名符号。
#   所以本文件里不能出现形如 "# CONFIG_XXX is not set" 的**说明性**注释，
#   只有真的要关闭某个符号时才写标准格式。
# ==============================================================================

# ---- SoC ---------------------------------------------------------------------
# MSM8940 与 MSM8937 是同一颗芯片的不同 SKU，4.19 基线没有单独的
# ARCH_MSM8940 符号，也不需要：4.9 里 PINCTRL_MSM8940 甚至是个悬空符号
# （Kconfig 有定义但 Makefile 从未引用），实际一直用 pinctrl-msm8937.o。
CONFIG_ARCH_MSM8937=y

# ---- OPPO 机型 ----------------------------------------------------------------
CONFIG_MACH_OPPO=y
CONFIG_MACH_OPPO_MSM8937=y
CONFIG_MACH_16061=y
CONFIG_OPPO_DEVICE_INFO=y

# ---- 触摸屏 -------------------------------------------------------------------
# A57 用 Goodix GT5688（R9s 是 Synaptics）。
# 注意：MACH_16061 与 MACH_16017/16027 可能同时开着以支持多机型，
# 这里只做加法（开 Goodix），不关 Synaptics ——
# 关掉会让同一份内核无法再驱动 R9s。
CONFIG_TOUCHPANEL_OPPO=y
CONFIG_TOUCHPANEL_GOODIX=y
CONFIG_TOUCHPANEL_GOODIX_GT5688=y

# ---- pinctrl ------------------------------------------------------------------
CONFIG_PINCTRL_MSM8937=y
CONFIG_PINCTRL_MSM8917=y

# ---- 显示屏 -------------------------------------------------------------------
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_DRM_PANEL=y
