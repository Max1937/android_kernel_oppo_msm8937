# ==============================================================================
# 纯净内核：关闭 KernelSU / BakaSU
# ------------------------------------------------------------------------------
# 背景：drivers/kernelsu/Kconfig 里 config KSU 是 "default y"，所以只要
# 不显式关掉，任何 defconfig 编出来都会自带 root（BakaSU）。
# 本片段的唯一作用就是把它明确关成 n，得到一个纯净内核。
#
# 用法（追加在 oppo-16017.config 之后）：
#   make O=out ARCH=arm64 vendor/msm8953-perf_defconfig \
#        vendor/mi8953.config vendor/oppo-16017.config vendor/oppo-no-ksu.config
#
# ⚠️ 本文件里不要出现 "# CONFIG_XXX=..." 形式的说明性注释。
#    scripts/kconfig/merge_config.sh 会把任何匹配
#    ^(# ){0,1}(CONFIG_[A-Za-z0-9_]*)[= ] 的行当成配置指令，
#    然后 sed 掉该符号 —— 会导致符号被静默删除而不是被忽略。
#    详见 README-4.19-port.md 的说明。
# ==============================================================================

# 主开关：关掉整个 KernelSU
# CONFIG_KSU is not set

# 下面是 KSU 的子项。主开关为 n 时它们本来就会自动变 n，
# 这里显式写出，是为了让最终 .config 里状态一目了然，
# 也防止将来 Kconfig 把某个子项改成 default y。
# CONFIG_KSU_KPROBES_KSUD is not set
# CONFIG_KSU_HACK_ARM64_BRANCH_LINK is not set
# CONFIG_KSU_TAMPER_SYSCALL_TABLE is not set
# CONFIG_KSU_FEATURE_SULOG is not set
# CONFIG_KSU_FEATURE_ADBROOT is not set
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_THRONE_TRACKER_ALWAYS_THREADED is not set
# CONFIG_KSU_LSM_SECURITY_HOOKS is not set
# CONFIG_KSU_HEURISTIC_IN_TREE_BUILD is not set
